# ==========================================
# 系統與環境配置
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# API 伺服器配置 (經由 Nginx 反向代理至多副本)
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=dev-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# 資料庫配置 (PostgreSQL 16)
# ==========================================
POSTGRES_USER=flash_user
POSTGRES_PASSWORD=flash_password
POSTGRES_DB=flash_ticket
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://flash_user:flash_password@postgres:5432/flash_ticket
SYNC_DATABASE_URL=postgresql://flash_user:flash_password@postgres:5432/flash_ticket

# ==========================================
# 快取與訊息佇列 (Redis 7)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==========================================
# 金流模擬服務配置
# ==========================================
PAYMENT_WEBHOOK_SECRET=mock-payment-signature-secret-key-32chars
PAYMENT_TIMEOUT_SECONDS=600

# ==========================================
# 監控與異常告警閾值 (Q6.2)
# ==========================================
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_P99_LATENCY_MS=2000
ALERT_OUTBOX_LAG_THRESHOLD=1000

# ==========================================
# 報表時區設定 (例如 Asia/Taipei)
# ==========================================
TIMEZONE=Asia/Taipei
