# 應用程式環境與日誌
ENVIRONMENT=development                    # 執行環境標籤（本機使用 development）
LOG_LEVEL=INFO                              # 日誌層級：DEBUG、INFO、WARNING、ERROR
INSTANCE_ID=api-default                     # 單一手動啟動程序的識別碼；Compose 會為各服務指定固定值

# API 與登入
APP_HOST=0.0.0.0                            # Uvicorn 綁定介面
APP_PORT=8000                               # Nginx 對主機開放的 HTTP port
SECRET_KEY=dev-super-secret-key-change-in-production-min-32-chars # JWT 簽章密鑰；正式環境務必換成隨機密鑰
JWT_ALGORITHM=HS256                          # JWT 簽章演算法
ACCESS_TOKEN_EXPIRE_MINUTES=60               # Access token 有效分鐘數

# PostgreSQL
POSTGRES_USER=flash_user                     # PostgreSQL 使用者名稱
POSTGRES_PASSWORD=flash_password             # PostgreSQL 密碼；正式環境請更換
POSTGRES_DB=flash_ticket                     # Compose 建立的資料庫名稱
POSTGRES_HOST=postgres                       # 手動啟動時使用的 PostgreSQL 主機；Compose DSN 固定使用服務名稱 postgres
POSTGRES_PORT=5432                           # 手動啟動時使用的 PostgreSQL port；Compose 容器間固定使用 5432
POSTGRES_HOST_PORT=5432                      # 映射到主機的 PostgreSQL port，可改以避開本機衝突
DATABASE_URL=postgresql+asyncpg://flash_user:flash_password@postgres:5432/flash_ticket # 手動啟動 API 時使用的非同步 DSN；Compose 會依 POSTGRES_* 組成
SYNC_DATABASE_URL=postgresql://flash_user:flash_password@postgres:5432/flash_ticket   # 報表等同步資料庫工作使用的 DSN；Compose 會依 POSTGRES_* 組成

# Redis
REDIS_PORT=6379                              # 映射到主機的 Redis port
REDIS_URL=redis://redis:6379/0                # Redis DSN；Compose 容器間使用 redis:6379

# 模擬金流
PAYMENT_WEBHOOK_SECRET=mock-payment-signature-secret-key-32chars # 模擬 Webhook 簽章密鑰；正式環境請更換
PAYMENT_TIMEOUT_SECONDS=600                  # 訂單等待付款的秒數

# 告警門檻
ALERT_ERROR_RATE_THRESHOLD=0.05              # 5xx 比率告警門檻（0.05 = 5%）
ALERT_P99_LATENCY_MS=2000                    # p99 延遲告警門檻（毫秒）
ALERT_OUTBOX_LAG_THRESHOLD=1000              # 待發 Outbox 筆數告警門檻
ALERT_BOOKING_FAILURE_RATE_THRESHOLD=0.90     # 購票失敗率告警門檻（0.90 = 90%）

# 報表時間
TIMEZONE=Asia/Taipei                         # Excel 報表時間顯示時區
